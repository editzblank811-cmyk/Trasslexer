class FakeTranslateHandler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    log_message = lambda *a, **k: None

    def _send(self, code, body, ctype="application/json"):
        data = body if isinstance(body, bytes) else body.encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        sp = urllib.parse.urlsplit(self.path)
        qs = urllib.parse.parse_qs(sp.query)
        if sp.path == "/auth":
            return self._send(200, "x" * 40, "text/plain")
        if sp.path.startswith("/api/v1/"):  # lingva
            text = urllib.parse.unquote(sp.path.split("/", 5)[5])
            return self._send(200, json.dumps({"translation": fake_tr(text)}))
        if sp.path == "/m":
            text = qs["q"][0]
            return self._send(200, "<html><div class=\"result-container\">%s</div></html>" %
                              fake_tr(text).replace("\n", "<br>"), "text/html")
        if sp.path == "/get":  # mymemory
            return self._send(200, json.dumps({"responseData": {"translatedText": fake_tr(qs["q"][0])},
                                               "responseStatus": 200}))
        if sp.path == "/translate_a/single":
            return self.google(qs["q"][0])
        self._send(404, "no")

    def do_POST(self):
        n = int(self.headers.get("Content-Length", "0"))
        body = self.rfile.read(n)
        sp = urllib.parse.urlsplit(self.path)
        if sp.path == "/translate_a/single":
            q = urllib.parse.parse_qs(body.decode("utf-8"))["q"][0]
            return self.google(q)
        if sp.path == "/translate":
            if self.headers.get("Authorization", "").startswith("Bearer "):
                items = json.loads(body.decode("utf-8"))
                return self._send(200, json.dumps([{"translations": [{"text": fake_tr(i["Text"]), "to": "hi"}]}
                                                   for i in items]))
            return self._send(401, "{}")
        self._send(404, "no")

    def google(self, q):
        segs = []
        lines = q.split("\n")
        for i, line in enumerate(lines):
            suffix = "\n" if i < len(lines) - 1 else ""
            segs.append([fake_tr(line) + suffix, line + suffix, None, None, 10])
        self._send(200, json.dumps([segs, None, "zh-CN"]))


class FakeTelegram:
    """Tiny Bot API: one document update, records everything the bot does."""

    def __init__(self, document_bytes, file_name, token="1234567:" + "A" * 30, extra_updates=None):
        self.token = token
        self.doc_bytes = document_bytes
        self.file_name = file_name
        self.sent_messages = []
        self.edits = []
        self.uploads = []
        self.updates = [{"update_id": 1, "message": {
            "message_id": 5, "chat": {"id": 777}, "document": {
                "file_id": "FILE1", "file_name": file_name, "file_size": len(document_bytes),
                "mime_type": "application/octet-stream"}}}]
        if extra_updates:
            self.updates += extra_updates
        self.delivered = False
        outer = self

        class H(BaseHTTPRequestHandler):
            protocol_version = "HTTP/1.1"
            log_message = lambda *a, **k: None

            def _json(self, obj):
                data = json.dumps(obj).encode()
                self.send_response(200)
                self.send_header("Content-Type", "application/json")
                self.send_header("Content-Length", str(len(data)))
                self.end_headers()
                self.wfile.write(data)

            def do_GET(self):
                if self.path == f"/file/bot{outer.token}/docs/file1":
                    data = outer.doc_bytes
                    self.send_response(200)
                    self.send_header("Content-Length", str(len(data)))
                    self.end_headers()
                    self.wfile.write(data)
                else:
                    self.send_response(404)
                    self.send_header("Content-Length", "0")
                    self.end_headers()

            def do_POST(self):
                n = int(self.headers.get("Content-Length", "0"))
                body = self.rfile.read(n)
                method = self.path.rsplit("/", 1)[-1]
                if not self.path.startswith(f"/bot{outer.token}/"):
                    return self._json({"ok": False, "error_code": 401, "description": "Unauthorized"})
                if method == "sendDocument":
                    outer.uploads.append((self.headers.get("Content-Type"), body))
                    return self._json({"ok": True, "result": {"message_id": 99}})
                params = json.loads(body.decode() or "{}")
                if method == "getMe":
                    return self._json({"ok": True, "result": {"username": "fakebot"}})
                if method == "deleteWebhook":
                    return self._json({"ok": True, "result": True})
                if method == "getUpdates":
                    if not outer.delivered:
                        outer.delivered = True
                        return self._json({"ok": True, "result": outer.updates})
                    time.sleep(0.3)
                    return self._json({"ok": True, "result": []})
                if method == "getFile":
                    return self._json({"ok": True, "result": {"file_path": "docs/file1"}})
                if method == "sendMessage":
                    outer.sent_messages.append(params)
                    return self._json({"ok": True, "result": {"message_id": 41}})
                if method == "editMessageText":
                    outer.edits.append(params)
                    return self._json({"ok": True, "result": True})
                if method == "answerCallbackQuery":
                    return self._json({"ok": True, "result": True})
                return self._json({"ok": False, "error_code": 404, "description": "unknown"})

        self.server = ThreadingHTTPServer(("127.0.0.1", 0), H)
        self.url = f"http://127.0.0.1:{self.server.server_address[1]}"
        threading.Thread(target=self.server.serve_forever, daemon=True).start()

    def close(self):
        self.server.shutdown()
        self.server.server_close()

    def uploaded_files(self):
        """Parse our own multipart bodies -> {filename: bytes}"""
        files = {}
        for ctype, body in self.uploads:
            boundary = ctype.split("boundary=")[1].encode()
            for part in body.split(b"--" + boundary):
                m = re.search(rb'filename="([^"]+)"\r\nContent-Type: [^\r]*\r\n\r\n', part)
                if m:
                    content = part[m.end():]
                    if content.endswith(b"\r\n"):
                        content = content[:-2]
                    files[m.group(1).decode("utf-8")] = content
        return files


def make_epub(path, encoding="utf-8"):
    chapters = {}
    for i in range(1, 4):
        body = "".join(f"<p>第{i}章 第{j}段 这是测试的内容，欢迎使用翻译机器人。Hello number {j}!</p>\n"
                       for j in range(1, 40))
        chapters[f"OEBPS/ch{i}.xhtml"] = (
            f'<?xml version="1.0" encoding="{encoding}"?>\n'
            '<html xmlns="http://www.w3.org/1999/xhtml" lang="zh"><head><title>章节</title></head>'
            f"<body><h1>第{i}章</h1>\n{body}<pre>代码 一\n代码 二</pre></body></html>").encode(encoding)
    opf = ('<?xml version="1.0" encoding="utf-8"?><package xmlns="http://www.idpf.org/2007/opf" version="2.0">'
           '<metadata xmlns:dc="http://purl.org/dc/elements/1.1/"><dc:title>测试之书</dc:title>'
           '<dc:language>zh</dc:language><dc:identifier id="id">urn:uuid:1</dc:identifier></metadata><manifest>'
           '<item id="ncx" href="toc.ncx" media-type="application/x-dtbncx+xml"/>'
           '<item id="c1" href="ch1.xhtml" media-type="application/xhtml+xml"/>'
           '<item id="c2" href="ch2.xhtml" media-type="application/xhtml+xml"/>'
           '<item id="c3" href="ch3.xhtml" media-type="application/xhtml+xml"/>'
           '<item id="img" href="cover.png" media-type="image/png"/></manifest>'
           '<spine toc="ncx"><itemref idref="c1"/><itemref idref="c2"/><itemref idref="c3"/></spine></package>')
    ncx = ('<?xml version="1.0" encoding="utf-8"?><ncx xmlns="http://www.daisy.org/z3986/2005/ncx/">'
           '<docTitle><text>测试之书</text></docTitle><navMap><navPoint id="n1"><navLabel><text>第一章</text>'
           '</navLabel><content src="ch1.xhtml"/></navPoint></navMap></ncx>')
    with zipfile.ZipFile(path, "w") as z:
        z.writestr(zipfile.ZipInfo("mimetype"), "application/epub+zip")
        z.writestr("META-INF/container.xml",
                   '<?xml version="1.0"?><container xmlns="urn:oasis:names:tc:opendocument:xmlns:container" '
                   'version="1.0"><rootfiles><rootfile full-path="OEBPS/content.opf" '
                   'media-type="application/oebps-package+xml"/></rootfiles></container>')
        z.writestr("OEBPS/content.opf", opf)
        z.writestr("OEBPS/toc.ncx", ncx)
        for name, data in chapters.items():
            z.writestr(name, data)
        z.writestr("OEBPS/cover.png", b"\x89PNG\r\n\x1a\n" + os.urandom(2000))


class EngineParsingTests(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        cls.srv = ThreadingHTTPServer(("127.0.0.1", 0), FakeTranslateHandler)
        cls.base = f"http://127.0.0.1:{cls.srv.server_address[1]}"
        threading.Thread(target=cls.srv.serve_forever, daemon=True).start()

    @classmethod
    def tearDownClass(cls):
        cls.srv.shutdown()
        cls.srv.server_close()

    def check(self, engine, texts=None):
        texts = texts or ["你好，世界", "第二行 test & more", "第三行"]
        want = [fake_tr(t) for t in texts]
        got = engine.translate(texts, "zh")
        self.assertEqual([g.strip() for g in got], want)
        self.assertEqual(engine.translate(["单行"], "zh"), [fake_tr("单行")])

    def test_google_post(self):
        e = bot.GoogleEngine(base=self.base)
        self.check(e)
        self.assertTrue(e.use_post)

    def test_google_get_fallback(self):
        e = bot.GoogleEngine(base=self.base)
        e.use_post = False
        self.check(e)

    def test_google_mobile(self):
        self.check(bot.GoogleMobileEngine(base=self.base))

    def test_bing(self):
        self.check(bot.BingEngine(auth_url=self.base + "/auth", api_url=self.base + "/translate"))

    def test_lingva(self):
        self.check(bot.LingvaEngine(self.base))

    def test_mymemory(self):
        e = bot.MyMemoryEngine(base=self.base)
        self.assertEqual(e.translate(["你好"], "zh"), [fake_tr("你好")])

    def test_dead_host_raises_engine_error(self):
        e = bot.GoogleEngine(base="http://127.0.0.1:9")
        with self.assertRaises(bot.EngineError):
            e.translate(["你好"], "zh")

    def test_default_engine_list(self):
        names = [e.name for e in bot.build_engines({})]
        for n in ("google", "bing", "google-mobile", "yandex", "mymemory"):
            self.assertIn(n, names)
        self.assertTrue(any(n.startswith("lingva:") for n in names))
        off = [e.name for e in bot.build_engines({"DISABLE_ENGINES": "yandex,mymemory"})]
        self.assertNotIn("yandex", off)
        self.assertNotIn("mymemory", off)


class FileTests(unittest.TestCase):
    def translate_all(self, proc, sl="zh"):
        texts = proc.table.texts
        run = bot.Run(texts, [FakeEngine("a"), FakeEngine("b")], sl, threading.Event())
        run.execute()
        return run.results()

    def test_epub_roundtrip(self):
        for enc in ("utf-8", "gb18030"):
            with tempfile.TemporaryDirectory() as d:
                src, out = os.path.join(d, "in.epub"), os.path.join(d, "out.epub")
                make_epub(src, enc)
                proc = bot.EpubProcessor(src)
                proc.load()
                self.assertGreater(len(proc.table.texts), 100)
                proc.build(self.translate_all(proc), out)
                with zipfile.ZipFile(out) as z:
                    self.assertEqual(z.namelist()[0], "mimetype")
                    self.assertEqual(z.getinfo("mimetype").compress_type, zipfile.ZIP_STORED)
                    self.assertIsNone(z.testzip())
                    ch1 = z.read("OEBPS/ch1.xhtml").decode("utf-8")
                    self.assertIn('encoding="utf-8"', ch1)
                    self.assertIn('lang="hi"', ch1)
                    self.assertNotRegex(ch1, bot.CJK_RE)
                    import xml.dom.minidom
                    for n in ("OEBPS/ch1.xhtml", "OEBPS/ch2.xhtml", "OEBPS/toc.ncx", "OEBPS/content.opf"):
                        xml.dom.minidom.parseString(z.read(n))
                    self.assertIn("<dc:language>hi</dc:language>", z.read("OEBPS/content.opf").decode())
                    self.assertNotIn("测试之书", z.read("OEBPS/content.opf").decode())
                    self.assertNotIn("第一章", z.read("OEBPS/toc.ncx").decode())
                    self.assertEqual(z.read("OEBPS/cover.png"), zipfile.ZipFile(src).read("OEBPS/cover.png"))
                units = proc.scan_output(out)
                flags = [bot.final_flag(u) for u in units]
                self.assertNotIn("problem", flags)

