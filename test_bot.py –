def fake_tr(s):
    """Pretend translator: every letter becomes a Devanagari letter."""
    return "".join(chr(0x0905 + ord(c) % 40) if c.isalpha() else c for c in s)


# ----------------------------------------------------------------- fake engines
class FakeEngine(bot.Engine):
    def __init__(self, name, tier=0, threads=3, max_items=8, mode="ok", rescue_only=False):
        super().__init__()
        self.name = name
        self.tier = tier
        self.threads = threads
        self.max_items = max_items
        self.item_limit = max_items
        self.mode = mode
        self.rescue_only = rescue_only
        self.calls = 0
        self.t_start = time.time()

    def translate(self, texts, sl):
        self.calls += 1
        if self.mode == "ok":
            return [fake_tr(t) for t in texts]
        if self.mode == "misalign":
            if len(texts) > 1:
                raise bot.AlignError()
            return [fake_tr(texts[0])]
        if self.mode == "flaky":
            if self.calls % 3 == 0:
                raise bot.EngineError("boom")
            return [fake_tr(t) for t in texts]
        if self.mode == "untranslated":
            return list(texts)
        if self.mode == "dead":
            raise bot.EngineError("down", rate=True)
        if self.mode == "crash":
            raise ValueError("bug in engine")
        if self.mode == "outage":     # whole service down for the first 2.5 seconds
            if time.time() - self.t_start < 2.5:
                raise bot.EngineError("network: unreachable")
            return [fake_tr(t) for t in texts]
        if self.mode == "poison":     # any request containing 毒 fails (like a text an engine chokes on)
            if any("毒" in t for t in texts):
                raise bot.EngineError("HTTP 500")
            return [fake_tr(t) for t in texts]
        if self.mode == "stubborn":  # leaves lines containing 特 untranslated unless short
            return [t if ("特" in t and len(t) > 80) else fake_tr(t) for t in texts]
        raise AssertionError(self.mode)


class HelperTests(unittest.TestCase):
    def test_split_pieces_keeps_all_text(self):
        text = "你好，世界。" * 500
        pieces = bot.split_pieces(text, 100)
        self.assertTrue(all(len(p) <= 100 for p in pieces))
        self.assertEqual(re.sub(r"\s", "", "".join(pieces)), text)
        words = " ".join(["word"] * 900)
        pieces = bot.split_pieces(words, 100)
        self.assertTrue(all(len(p) <= 100 for p in pieces))
        self.assertEqual(" ".join(pieces).split(), words.split())
        self.assertEqual(bot.split_pieces("短", 100), ["短"])
        blob = "x" * 3000
        self.assertEqual("".join(bot.split_pieces(blob, 1000)), blob)

    def test_split_aligned(self):
        self.assertEqual(bot.split_aligned("a\nb\n", 2), ["a", "b"])
        with self.assertRaises(bot.AlignError):
            bot.split_aligned("a\nb\nc", 2)
        self.assertEqual(bot.split_aligned("a\nb", 1), ["a b"])

    def test_scores(self):
        self.assertEqual(bot.leftover_score("你好", "नमस्ते"), 0.0)
        self.assertGreater(bot.leftover_score("你好", "你好"), 0)
        self.assertGreater(bot.leftover_score("你好", "नमस्ते 你好"), 0)
        self.assertGreater(bot.leftover_score("hello", ""), 0)
        self.assertGreater(bot.leftover_score("some english line here", "some english line here"), 0)
        self.assertEqual(bot.final_flag("नमस्ते दुनिया"), None)
        self.assertEqual(bot.final_flag("Zhang Wei"), "kept")
        self.assertEqual(bot.final_flag("这是没有翻译的中文"), "problem")
        self.assertEqual(bot.final_flag("This sentence was never translated at all, sorry"), "problem")
        self.assertEqual(bot.final_flag("1234 ..."), None)

    def test_detect_source(self):
        self.assertEqual(bot.detect_source(["你好世界，这是测试"]), "zh")
        self.assertEqual(bot.detect_source(["This is a normal English sentence."]), "en")
        self.assertEqual(bot.detect_source(["123 456"]), "auto")

    def test_decode(self):
        gbk = "你好，世界".encode("gb18030")
        self.assertEqual(bot.decode_text(gbk), "你好，世界")
        self.assertEqual(bot.decode_text("你好".encode("utf-8-sig")), "你好")
        self.assertEqual(bot.decode_text("你好".encode("utf-16")), "你好")
        self.assertEqual(bot.decode_text("你好".encode("big5")), "你好")

    def test_markup_roundtrip_is_lossless(self):
        doc = ('<?xml version="1.0" encoding="utf-8"?><!DOCTYPE html>'
               '<html xmlns="http://www.w3.org/1999/xhtml" lang="zh-CN"><head><title>书</title>'
               '<style>p{color:red} /* <b> */</style></head><body>'
               '<!-- 注释 <p>x</p> --><p class="a>b">第一章 &amp; &lt;你好&gt; <b>世界</b></p>'
               '<pre>  行一\n  line two\n</pre><script>if (a<b) {document.write("<p>你</p>")}</script>'
               '<p>12345</p><p>&#160;</p><![CDATA[ 你好 ]]></body></html>')
        table = bot.SegTable()
        parts = bot.parse_markup(doc, bot.make_translate_handler(table))
        ident = bot.render_parts(parts, [t for t in table.texts])
        self.assertEqual(ident.replace('lang="hi"', 'lang="zh-CN"'), doc)
        self.assertIn("书", table.texts)
        # script/style/comment/CDATA text must not become segments
        joined = " ".join(table.texts)
        self.assertNotIn("color", joined)
        self.assertNotIn("document", joined)
        self.assertNotIn("注释", joined)
        # pre lines are separate segments
        self.assertIn("行一", table.texts)
        self.assertIn("line two", table.texts)
        # translated render keeps entities escaped
        tr = [fake_tr(t) for t in table.texts]
        out = bot.render_parts(parts, tr)
        self.assertIn("&amp;", out)
        self.assertIn("&lt;", out)
        self.assertIn("</script>", out)

    def test_translated_xhtml_stays_well_formed(self):
        import xml.dom.minidom
        doc = ('<?xml version="1.0" encoding="utf-8"?>'
               '<html xmlns="http://www.w3.org/1999/xhtml" lang="zh-CN"><head><title>书</title>'
               '<style>p{color:red}</style></head><body>'
               '<p class="a>b">第一章 &amp; &lt;你好&gt; <b>世界</b> 结束。</p>'
               '<pre>  行一\n  line two\n</pre>'
               '<script><![CDATA[ if (a<b) { x("<p>你</p>") } ]]></script>'
               '<p>12345</p><p>&#160;</p></body></html>')
        xml.dom.minidom.parseString(doc.encode("utf-8"))      # sample itself is valid
        table = bot.SegTable()
        parts = bot.parse_markup(doc, bot.make_translate_handler(table))
        out = bot.render_parts(parts, [fake_tr(t) for t in table.texts])
        xml.dom.minidom.parseString(out.encode("utf-8"))
        self.assertNotRegex(out.split("<script>")[0], bot.CJK_RE)

    def test_clean_result_removes_bad_xml_chars(self):
        self.assertEqual(bot.clean_result("a\x0bb\x00 c\n d"), "ab c d")


class RunTests(unittest.TestCase):
    def make_texts(self, n=300):
        texts = []
        for i in range(n):
            texts.append(f"第{i}章 这是一个测试句子，用来检查翻译是否完整。" * (1 + i % 3))
        return texts

    def run_run(self, engines, texts, **kw):
        run = bot.Run(texts, engines, "zh", threading.Event(), **kw)
        run.execute()
        return run

    def test_all_good(self):
        texts = self.make_texts()
        run = self.run_run([FakeEngine("a"), FakeEngine("b", threads=2)], texts)
        res = run.results()
        self.assertEqual(res, [fake_tr(t) for t in texts])
        self.assertEqual(run.done_count, len(texts))
        self.assertEqual(run.bad_indexes(), [])

    def test_mixed_flaky_engines_still_perfect(self):
        texts = self.make_texts()
        engines = [FakeEngine("ok"), FakeEngine("flaky", mode="flaky"),
                   FakeEngine("misalign", mode="misalign"), FakeEngine("dead", mode="dead"),
                   FakeEngine("crash", mode="crash"), FakeEngine("lazy", mode="untranslated")]
        run = self.run_run(engines, texts)
        res = run.results()
        self.assertEqual(res, [fake_tr(t) for t in texts])
        self.assertEqual(run.bad_indexes(), [])
        for e in engines:
            if e.name == "ok":
                continue
            self.assertEqual(run.engine_chars[e.name] if e.name not in ("flaky", "misalign") else 0, 0)

    def test_untranslated_lines_are_retried_on_other_engines(self):
        texts = self.make_texts(60)
        lazy = FakeEngine("lazy", mode="untranslated", threads=6)
        good = FakeEngine("good", threads=1)
        run = self.run_run([lazy, good], texts)
        self.assertEqual(run.results(), [fake_tr(t) for t in texts])
        self.assertGreater(run.retried, 0)

    def test_everything_untranslated_is_reported_not_crashed(self):
        texts = ["这是一句话。", "另一句话。"]
        run = self.run_run([FakeEngine("l1", mode="untranslated"),
                            FakeEngine("l2", mode="untranslated")], texts)
        self.assertEqual(sorted(run.bad_indexes()), [0, 1])
        self.assertEqual(run.results(), texts)

    def test_rescue_pass_fixes_stubborn_lines(self):
        long_line = "特" + "这是很长的一句话，" * 12
        texts = [long_line, "短句子。"]
        engines = [FakeEngine("s1", mode="stubborn"), FakeEngine("s2", mode="stubborn")]
        run = self.run_run(engines, texts)
        self.assertEqual(run.bad_indexes(), [0])
        fixed = bot.rescue_pass(run, engines, "zh", threading.Event())
        self.assertEqual(fixed, 1)
        self.assertEqual(bot.leftover_score(long_line, run.results()[0]), 0.0)

    def test_short_outage_does_not_produce_untranslated_lines(self):
        texts = self.make_texts(80)
        engines = [FakeEngine("n1", mode="outage"), FakeEngine("n2", mode="outage", threads=2),
                   FakeEngine("n3", mode="outage", max_items=1)]
        run = self.run_run(engines, texts)
        self.assertEqual(run.results(), [fake_tr(t) for t in texts])
        self.assertEqual(run.bad_indexes(), [])

    def test_poison_line_cannot_block_the_others(self):
        texts = self.make_texts(40)
        texts[17] = "这一行有毒，引擎无法处理。"
        engines = [FakeEngine("p1", mode="poison", max_items=10), FakeEngine("p2", mode="poison", max_items=10)]
        run = self.run_run(engines, texts)
        res = run.results()
        self.assertEqual(run.bad_indexes(), [17])
        self.assertEqual(res[17], texts[17])
        for i, t in enumerate(texts):
            if i != 17:
                self.assertEqual(res[i], fake_tr(t))

    def test_stall_raises(self):
        run = bot.Run(["你好世界"], [FakeEngine("d", mode="dead")], "zh", threading.Event(), stall=1.5)
        with self.assertRaises(bot.Stalled):
            run.execute()

    def test_cancel(self):
        ev = threading.Event()
        run = bot.Run(self.make_texts(50), [FakeEngine("d", mode="dead")], "zh", ev, stall=60)
        threading.Timer(0.6, ev.set).start()
        with self.assertRaises(bot.Cancelled):
            run.execute()

    def test_empty_run(self):
        run = bot.Run([], [FakeEngine("a")], "zh", threading.Event())
        run.execute()
        self.assertEqual(run.results(), [])


