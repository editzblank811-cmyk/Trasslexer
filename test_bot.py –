            self.assertTrue(any("not a valid EPUB" in e["text"] for e in fake.edits))
        finally:
            fake.close()

    def test_time_limit_drains_running_jobs_then_stops(self):
        text = "\n".join(f"第{i}行：这是测试内容。" for i in range(200)).encode("utf-8")
        fake = FakeTelegram(text, "d.txt")
        tg = bot.TgClient(fake.token, fake.url)
        slow = FakeEngine("slow", threads=4, max_items=4)
        orig = slow.translate

        def slow_translate(texts, sl):
            time.sleep(0.15)
            return orig(texts, sl)
        slow.translate = slow_translate
        b = bot.Bot(tg, [slow])
        result = {}

        def poll():
            result["r"] = bot.poll_loop(b, tg, time.time() + 2.0)
        t = threading.Thread(target=poll, daemon=True)
        t.start()
        try:
            t.join(timeout=30)
            self.assertFalse(t.is_alive())
            offset, timed_out = result["r"]
            self.assertTrue(timed_out)
            self.assertEqual(offset, 2)
            self.assertTrue(b.jobs)                     # job still running when polling stopped
            self.assertTrue(b.wait_idle(60))            # ...and it is allowed to finish
            self.assertEqual(list(fake.uploaded_files()), ["d_hindi.txt"])
        finally:
            bot.STOP.set()
            b.shutdown()
            fake.close()

    def test_cancel_button(self):
        text = "\n".join(f"第{i}行：这是测试内容。" for i in range(3000)).encode("utf-8")
        cb = {"update_id": 9, "callback_query": {"id": "cb1", "data": "c:NOPE", "message": {"chat": {"id": 777}}}}
        fake = FakeTelegram(text, "slow.txt", extra_updates=[cb])
        tg = bot.TgClient(fake.token, fake.url)
        slow = FakeEngine("slow", threads=1, max_items=1)
        orig = slow.translate

        def slow_translate(texts, sl):
            time.sleep(0.2)
            return orig(texts, sl)
        slow.translate = slow_translate
        b = bot.Bot(tg, [slow])
        t = threading.Thread(target=bot.poll_loop, args=(b, tg), daemon=True)
        t.start()
        try:
            end = time.time() + 20
            while time.time() < end and not b.jobs:
                time.sleep(0.1)
            self.assertTrue(b.jobs)
            job = list(b.jobs.values())[0]
            time.sleep(1.0)
            b.on_callback({"id": "cb2", "data": f"c:{job.id}", "message": {"chat": {"id": 777}}})
            end = time.time() + 20
            while time.time() < end and not any("Cancelled" in e["text"] for e in fake.edits):
                time.sleep(0.1)
            self.assertTrue(any("Cancelled" in e["text"] for e in fake.edits))
            self.assertEqual(fake.uploads, [])
        finally:
            bot.STOP.set()
            b.shutdown()
            t.join(timeout=30)
            fake.close()


