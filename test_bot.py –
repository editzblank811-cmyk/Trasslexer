            "file_id": "X", "file_name": "a.pdf", "file_size": 10}}},
            {"update_id": 3, "message": {"message_id": 7, "chat": {"id": 777}, "document": {
                "file_id": "Y", "file_name": "big.epub", "file_size": 16 * 1024 * 1024}}},
            {"update_id": 4, "message": {"message_id": 8, "chat": {"id": 777}, "text": "/start"}},
