class EndToEndTests(unittest.TestCase):
    def setUp(self):
        self.tsrv = ThreadingHTTPServer(("127.0.0.1", 0), FakeTranslateHandler)
        self.tbase = f"http://127.0.0.1:{self.tsrv.server_address[1]}"
        threading.Thread(target=self.tsrv.serve_forever, daemon=True).start()
        bot.STOP.clear()

    def tearDown(self):
        self.tsrv.shutdown()
        self.tsrv.server_close()
        bot.STOP.clear()

    def engines(self):
        return [bot.GoogleEngine(base=self.tbase), bot.GoogleEngine("google-chrome", "dict-chrome-ex",
                                                                    base=self.tbase, threads=3),
                bot.BingEngine(auth_url=self.tbase + "/auth", api_url=self.tbase + "/translate"),
                bot.GoogleMobileEngine(base=self.tbase), bot.LingvaEngine(self.tbase),
                bot.MyMemoryEngine(base=self.tbase),
                bot.GoogleEngine("broken", "gtx", base="http://127.0.0.1:9", threads=2)]

    def run_bot(self, fake, wait_for_upload=True, timeout=60, extra=None):
        tg = bot.TgClient(fake.token, fake.url)
        b = bot.Bot(tg, self.engines())
        t = threading.Thread(target=bot.poll_loop, args=(b, tg), daemon=True)
        t.start()
        end = time.time() + timeout
        while time.time() < end:
            if wait_for_upload and fake.uploads:
                break
            if not wait_for_upload and extra and extra():
                break
            time.sleep(0.2)
        time.sleep(0.5)
        bot.STOP.set()
        b.shutdown()
        t.join(timeout=60)
        return b

    def test_epub_end_to_end(self):
        with tempfile.TemporaryDirectory() as d:
            src = os.path.join(d, "novel.epub")
            make_epub(src)
            with open(src, "rb") as f:
                data = f.read()
            fake = FakeTelegram(data, "我的 novel.epub")
            try:
                self.run_bot(fake)
                files = fake.uploaded_files()
                self.assertEqual(list(files), ["我的 novel_hindi.epub"])
                out = os.path.join(d, "o.epub")
                with open(out, "wb") as f:
                    f.write(files["我的 novel_hindi.epub"])
                with zipfile.ZipFile(out) as z:
                    self.assertIsNone(z.testzip())
                    self.assertNotRegex(z.read("OEBPS/ch2.xhtml").decode("utf-8"), bot.CJK_RE)
                final = fake.edits[-1]["text"]
                self.assertIn("Done", final)
                self.assertIn("No untranslated lines found", final)
                joined = "\n".join(e["text"] for e in fake.edits)
                self.assertIn("Used", joined)
                self.assertNotIn(fake.token, joined)
                self.assertTrue(any("█" in e["text"] or "░" in e["text"] for e in fake.edits + fake.sent_messages))
            finally:
                fake.close()

    def test_txt_end_to_end(self):
        text = "\n".join(f"第{i}行：这是测试内容。" for i in range(500)).encode("gb18030")
        fake = FakeTelegram(text, "a.txt")
        try:
            self.run_bot(fake)
            files = fake.uploaded_files()
            self.assertEqual(list(files), ["a_hindi.txt"])
            out = files["a_hindi.txt"].decode("utf-8")
            self.assertEqual(len(out.split("\n")), 500)
            self.assertNotRegex(out, bot.CJK_RE)
